NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

SENTRY_DSN=

CYPHER_DEMO_ADMIN_EMAIL=admin@cypher.pet
IMAGE_PROVIDER=mock
IMAGE_PROVIDER_WEBHOOK_SECRET=cypher-local-secret

# ── LLM 接入 ──────────────────────────────────────────────
# 任何 OpenAI-compatible 的 /chat/completions 服务都可以直接接。
# LLM_PROVIDER 只有 "mock" 是特殊值（离线固定回复）；其余值都走 HTTP。
# 服务不可达 / 超时的时候，聊天会退回内置模板回复（会重复同样的句子）。
#
# 方案 A：本地 MLX / vLLM 起的 Qwen（默认）
#   先在本地把 OpenAI-compatible 服务跑起来，再 npm run dev
LLM_PROVIDER=qwen
LLM_BASE_URL=http://127.0.0.1:8888/v1
LLM_API_KEY=1234
LLM_MODEL_CHAT=Qwen3.5-35B-A3B-4bit
LLM_MODEL_NARRATION=Qwen3.5-35B-A3B-4bit
LLM_MODEL_SOCIAL=Qwen3.5-35B-A3B-4bit
LLM_MODEL_ACTION=Qwen3.5-35B-A3B-4bit
#
# 方案 B：Kimi（Moonshot 开放平台，OpenAI-compatible）
#   模型名是 kimi-k2.5 时，请求会自动带 thinking: disabled 并去掉 temperature
# LLM_PROVIDER=kimi
# LLM_BASE_URL=https://api.moonshot.cn/v1   # 海外用 https://api.moonshot.ai/v1
# LLM_API_KEY=sk-xxxx                        # platform.moonshot.cn 申请
# LLM_MODEL_CHAT=kimi-k2.5
# LLM_MODEL_NARRATION=kimi-k2.5
# LLM_MODEL_SOCIAL=kimi-k2.5
# LLM_MODEL_ACTION=kimi-k2.5
#
# 方案 C：完全离线（不接任何模型，聊天/叙事用固定模板）
# LLM_PROVIDER=mock
LLM_BRIDGE_PYTHON=python3
LLM_BRIDGE_SCRIPT=
LLM_BRIDGE_MODEL_PATH=
LLM_TIMEOUT_MS=25000
LLM_RATE_LIMIT_PER_PET=3
LLM_RATE_LIMIT_PER_USER=10
LLM_GLOBAL_TOKEN_BUDGET_PER_MINUTE=24000
LLM_INTERACTIVE_RATE_LIMIT_PER_PET=18
LLM_INTERACTIVE_RATE_LIMIT_PER_USER=30
LLM_INTERACTIVE_TOKEN_BUDGET_PER_MINUTE=72000
LLM_AUTONOMY_ENABLED=true
LLM_AUTONOMY_PUBLIC_ONLY=false
LLM_AUTONOMY_ZONES=
GARDEN_BACKGROUND_TICK_ENABLED=false
GARDEN_TICK_SECRET=cypher-local-tick
GARDEN_TICK_INTERVAL_MS=15000
GARDEN_TICK_BASE_URL=http://127.0.0.1:3000
GARDEN_TICK_MATERIALIZE=false
GARDEN_TICK_MATERIALIZE_MIN_INTERVAL_MS=60000
