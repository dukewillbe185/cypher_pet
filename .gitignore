# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
# Keep every Next build dir ignored — Tailwind v4 scans all non-gitignored
# files for class candidates, and compiled chunks corrupt the generated CSS.
/.next/
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem
/storage/mock-db.runtime.json
/storage/source/*
/public/generated/generated-*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# playwright cli logs (large, transient)
/.playwright-cli/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
